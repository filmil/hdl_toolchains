"""sim_test: simulates HDL sources with the resolved simulator toolchain."""

_TOOLCHAIN = Label("//sim:toolchain_type")

def _quote(s):
    return "'" + s.replace("'", "'\\''") + "'"

def _spell(spelling, **values):
    return [arg.format(**values) for arg in spelling]

def _sim_test_impl(ctx):
    sim = ctx.toolchains[_TOOLCHAIN].sim

    # The test runs from the root of its runfiles, where short paths resolve.
    args = list(sim.extra_args)
    for name, value in ctx.attr.defines.items():
        if value:
            args += _spell(sim.define, name = name, value = value)
        else:
            args += _spell(sim.define_bare, name = name)

    incdirs = []
    for d in ctx.attr.includes:
        incdirs.append(ctx.label.package + "/" + d if ctx.label.package else d)
    for f in ctx.files.hdrs:
        d = f.short_path.rpartition("/")[0] or "."
        if d not in incdirs:
            incdirs.append(d)
    for d in incdirs:
        args += _spell(sim.incdir, dir = d)

    if ctx.attr.top:
        args += _spell(sim.top, top = ctx.attr.top)
    for p in ctx.attr.plusargs:
        args += _spell(sim.plusarg, arg = p)

    words = [_quote(a) for a in args]
    if ctx.attr.waves:
        if not sim.waves:
            fail("{}: the simulator toolchain cannot dump waveforms".format(ctx.label))
        dump = '"${TEST_UNDECLARED_OUTPUTS_DIR}"/' + _quote(ctx.label.name + "." + sim.waves_extension)
        for a in sim.waves:
            pre, found, post = a.partition("{file}")
            words.append(_quote(pre) + dump + _quote(post) if found else _quote(a))
    words += [_quote(f.short_path) for f in ctx.files.srcs]

    script = ctx.actions.declare_file(ctx.label.name + ".sh")
    ctx.actions.write(
        output = script,
        is_executable = True,
        content = "\n".join([
            "#!/usr/bin/env bash",
            "# Generated by sim_test. Runs the simulation; its exit code is the test's.",
            "set -euo pipefail",
            "exec " + " \\\n  ".join([_quote(sim.executable.short_path)] + words),
            "",
        ]),
    )
    runfiles = ctx.runfiles(files = ctx.files.srcs + ctx.files.hdrs + ctx.files.data + [sim.executable])
    runfiles = runfiles.merge(sim.runfiles)
    for d in ctx.attr.data:
        runfiles = runfiles.merge(d[DefaultInfo].default_runfiles)
    return [DefaultInfo(executable = script, runfiles = runfiles)]

sim_test = rule(
    implementation = _sim_test_impl,
    test = True,
    toolchains = [_TOOLCHAIN],
    doc = """Simulates `srcs` and passes when the simulator exits 0.

A simulation fails the test by exiting nonzero, as `$fatal` does. Whether an
`$error` also fails it depends on the toolchain; the xezim toolchain makes it
fail.""",
    attrs = {
        "srcs": attr.label_list(
            allow_files = [".v", ".sv", ".vh", ".svh"],
            mandatory = True,
            doc = "The sources, in compilation order.",
        ),
        "hdrs": attr.label_list(
            allow_files = [".v", ".sv", ".vh", ".svh"],
            doc = "Files for `include`. Their directories go on the include path.",
        ),
        "includes": attr.string_list(
            doc = "More include directories, relative to this package.",
        ),
        "defines": attr.string_dict(
            doc = "Preprocessor defines. An empty value defines the name alone.",
        ),
        "top": attr.string(
            doc = "The top module. Empty lets the simulator find it.",
        ),
        "plusargs": attr.string_list(
            doc = "Plusargs for $test$plusargs and $value$plusargs, without the leading +.",
        ),
        "waves": attr.bool(
            doc = "Dump waveforms into the test's undeclared outputs.",
        ),
        "data": attr.label_list(
            allow_files = True,
            doc = "Other files the simulation reads, such as memory images.",
        ),
    },
)
